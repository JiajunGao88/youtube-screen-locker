{
  "manifest_version": 3,
  "name": "YouTube Screen Locker",
  "version": "2.0.0",
  "minimum_chrome_version": "111",
  "description": "Lock YouTube against accidental clicks, shortcuts, and hardware media keys. Optional fullscreen deep lock shields browser and system shortcuts on Windows.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": [
        "lib/constants.js",
        "lib/platform.js",
        "lib/hostname.js",
        "lib/settings.js",
        "lib/hold-unlock.js",
        "lib/event-guard.js",
        "lib/fullscreen-lock.js",
        "lib/hud.js",
        "lib/screen-locker.js",
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": [
        "lib/media-session-guard.js",
        "lib/video-guard.js",
        "main-world-guard.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-lock": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Toggle YouTube screen lock"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
